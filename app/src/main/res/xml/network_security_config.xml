<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置（禁止默认明文流量）：
  - base-config: 默认禁止 cleartext（HTTP），只允许 HTTPS；
  - 仅对本地开发网关（模拟器宿主机 10.0.2.2 / 本机回环）放行明文，
    对应 ChatGatewayClient.DEFAULT_BASE_URL = http://10.0.2.2:3002。
  真机调试：若网关仍走明文 HTTP，需在此文件中把网关的局域网 IP 加入 domain-config，
  否则请求会被系统拦截（推荐最终改用 HTTPS 网关，然后删除整个 domain-config）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
